# Build and run artifacts. Nothing generated belongs in this repo.

# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/

# Virtualenvs
.venv/
venv/

# Packaging output for the python client, regenerated by `python -m build`
clients/python/dist/
clients/python/build/
clients/python/*.egg-info/

# SQL rendered from the jinja template in db/
db/rendered/
db/*.sql

# Editor and OS scratch
*.swp
.DS_Store
