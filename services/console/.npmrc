# openapi-typescript@7.13.0 peer-depends on typescript ^5.x; this project pins
# TypeScript ~6.0.2 (the version create-vite scaffolded, and what everything
# else here is fine with). The mismatch is just a stale peer-range - codegen
# works correctly on TS 6 - so relax peer-dep enforcement rather than pin an
# older TypeScript for the whole project to satisfy one dev tool's metadata.
legacy-peer-deps=true
