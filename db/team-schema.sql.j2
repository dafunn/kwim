-- KWIM per-team schema, rendered for team {{ kwim_team }} and applied as
-- kwim_user. Idempotent. Holds the team's episodic events, commit log, fact
-- verifications, review queue and documents. See docs/data-model.md.

CREATE SCHEMA IF NOT EXISTS {{ kwim_team }};

CREATE TABLE IF NOT EXISTS {{ kwim_team }}.episodic_events (
    id                 uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    agent_id           text        NOT NULL,
    session_id         text        NOT NULL,
    event_type         text        NOT NULL,
    event_data         jsonb       NOT NULL DEFAULT '{}'::jsonb,
    occurred_at        timestamptz NOT NULL DEFAULT now(),
    compressed_summary text,
    archived           boolean     NOT NULL DEFAULT false
);

CREATE INDEX IF NOT EXISTS idx_{{ kwim_team }}_episodic_session
    ON {{ kwim_team }}.episodic_events (session_id, occurred_at);
CREATE INDEX IF NOT EXISTS idx_{{ kwim_team }}_episodic_agent
    ON {{ kwim_team }}.episodic_events (agent_id, occurred_at);
CREATE INDEX IF NOT EXISTS idx_{{ kwim_team }}_episodic_unarchived
    ON {{ kwim_team }}.episodic_events (occurred_at) WHERE NOT archived;

-- Governance commit log: append-only, replayed in seq order to rebuild the graph.
-- payload is a node's content and provenance its edges.
CREATE TABLE IF NOT EXISTS {{ kwim_team }}.commit_log (
    seq           bigserial   PRIMARY KEY,
    id            uuid        NOT NULL DEFAULT gen_random_uuid(),
    committed_at  timestamptz NOT NULL DEFAULT now(),
    object_type   text        NOT NULL CHECK (object_type IN ('fact','rule','semantic','document')),
    object_id     text        NOT NULL,
    operation     text        NOT NULL CHECK (operation IN ('commit','deprecate','reinforce','retract','confirm','amend','revise')),
    payload       jsonb       NOT NULL DEFAULT '{}'::jsonb,
    provenance    jsonb       NOT NULL DEFAULT '{}'::jsonb,
    proposed_by   text,
    source_kind   text        CHECK (source_kind IN ('agent_proposal','repo_sync','promotion','distiller')),
    gate_decision text        CHECK (gate_decision IN ('auto_committed','human_approved','human_retracted','human_confirmed'))
);

CREATE INDEX IF NOT EXISTS idx_{{ kwim_team }}_commit_object
    ON {{ kwim_team }}.commit_log (object_id, seq);
CREATE INDEX IF NOT EXISTS idx_{{ kwim_team }}_commit_type
    ON {{ kwim_team }}.commit_log (object_type, committed_at);

-- Retrofit: widen the CHECKs on existing teams (DROP IF EXISTS, then ADD).
ALTER TABLE {{ kwim_team }}.commit_log DROP CONSTRAINT IF EXISTS commit_log_operation_check;
ALTER TABLE {{ kwim_team }}.commit_log ADD CONSTRAINT commit_log_operation_check
    CHECK (operation IN ('commit','deprecate','reinforce','retract','confirm','amend','revise',
                         'retire','restore'));

ALTER TABLE {{ kwim_team }}.commit_log DROP CONSTRAINT IF EXISTS commit_log_object_type_check;
ALTER TABLE {{ kwim_team }}.commit_log ADD CONSTRAINT commit_log_object_type_check
    CHECK (object_type IN ('fact','rule','semantic','document','skill'));

ALTER TABLE {{ kwim_team }}.commit_log DROP CONSTRAINT IF EXISTS commit_log_source_kind_check;
ALTER TABLE {{ kwim_team }}.commit_log ADD CONSTRAINT commit_log_source_kind_check
    CHECK (source_kind IN ('agent_proposal','repo_sync','promotion','distiller'));

ALTER TABLE {{ kwim_team }}.commit_log DROP CONSTRAINT IF EXISTS commit_log_gate_decision_check;
ALTER TABLE {{ kwim_team }}.commit_log ADD CONSTRAINT commit_log_gate_decision_check
    CHECK (gate_decision IN ('auto_committed','human_approved','human_retracted','human_confirmed'));

-- last_verified_at for each fact, one upserted row per fact, reapplied by a
-- rebuild. See docs/DESIGN.md, "The commit log is the source of truth".
CREATE TABLE IF NOT EXISTS {{ kwim_team }}.fact_verifications (
    fact_id          text        PRIMARY KEY,
    last_verified_at timestamptz NOT NULL DEFAULT now(),
    verified_by      text
);

-- Review queue: proposals the gate routed to review, resolved by an atomic claim
-- (UPDATE ... WHERE resolved_at IS NULL RETURNING *). Rejected rows are kept.
CREATE TABLE IF NOT EXISTS {{ kwim_team }}.pending_proposals (
    proposal_id  uuid        PRIMARY KEY,
    object_type  text        NOT NULL CHECK (object_type IN ('fact','rule')),
    proposed_by  text,
    body         jsonb       NOT NULL,
    bus_message  jsonb       NOT NULL,
    created_at   timestamptz NOT NULL DEFAULT now(),
    resolved_at  timestamptz,
    resolution   text        CHECK (resolution IN ('approved','rejected')),
    resolved_by  text,
    resolved_via text        CHECK (resolved_via IN ('api','mattermost','admin_console')),
    reject_reason text
);

CREATE INDEX IF NOT EXISTS idx_{{ kwim_team }}_pending_open
    ON {{ kwim_team }}.pending_proposals (created_at) WHERE resolved_at IS NULL;

-- Retrofit: widen the CHECK on existing teams (DROP IF EXISTS, then ADD). Placed
-- after the CREATE TABLE it modifies.
ALTER TABLE {{ kwim_team }}.pending_proposals DROP CONSTRAINT IF EXISTS pending_proposals_object_type_check;
ALTER TABLE {{ kwim_team }}.pending_proposals ADD CONSTRAINT pending_proposals_object_type_check
    CHECK (object_type IN ('fact','rule','skill'));
ALTER TABLE {{ kwim_team }}.pending_proposals DROP CONSTRAINT IF EXISTS pending_proposals_resolved_via_check;
ALTER TABLE {{ kwim_team }}.pending_proposals ADD CONSTRAINT pending_proposals_resolved_via_check
    CHECK (resolved_via IN ('api','mattermost','admin_console'));

-- Documents: one row per uploaded document. The original files live on the
-- documents volume, addressed by sha256.
CREATE TABLE IF NOT EXISTS {{ kwim_team }}.documents (
    id               uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
    title            text        NOT NULL,
    tags             jsonb       NOT NULL DEFAULT '[]'::jsonb,
    status           text        NOT NULL DEFAULT 'ingesting'
                                 CHECK (status IN ('ingesting','ready','failed','retracted')),
    current_revision uuid,
    created_at       timestamptz NOT NULL DEFAULT now(),
    created_by       text,
    updated_at       timestamptz NOT NULL DEFAULT now()
);

-- One row per uploaded revision of a document. `extracted` holds the extractor's
-- intermediate format and is what chunking and rebuild read. The document's
-- current_revision is its newest ready revision.
CREATE TABLE IF NOT EXISTS {{ kwim_team }}.document_revisions (
    id                uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
    document_id       uuid        NOT NULL REFERENCES {{ kwim_team }}.documents(id) ON DELETE CASCADE,
    revision_number   integer     NOT NULL,
    label             text,
    sha256            text        NOT NULL,
    mime_type         text        NOT NULL,
    filename          text,
    byte_size         bigint      NOT NULL,
    page_count        integer,
    extractor         text,
    extractor_version text,
    extracted         jsonb,
    status            text        NOT NULL DEFAULT 'ingesting'
                                  CHECK (status IN ('ingesting','ready','failed')),
    error             text,
    uploaded_at       timestamptz NOT NULL DEFAULT now(),
    uploaded_by       text,
    ingested_at       timestamptz,
    UNIQUE (document_id, revision_number)
);

-- Retrofit: promotion columns. A promoted team document records its universe
-- copy; the universe copy records where it came from.
ALTER TABLE {{ kwim_team }}.documents ADD COLUMN IF NOT EXISTS promoted_to uuid;
ALTER TABLE {{ kwim_team }}.documents ADD COLUMN IF NOT EXISTS promoted_from_team text;
ALTER TABLE {{ kwim_team }}.documents ADD COLUMN IF NOT EXISTS promoted_from_id uuid;

CREATE INDEX IF NOT EXISTS idx_{{ kwim_team }}_document_revisions_sha
    ON {{ kwim_team }}.document_revisions (sha256);

-- Figures cut from a revision; the image is on the documents volume.
CREATE TABLE IF NOT EXISTS {{ kwim_team }}.document_figures (
    revision_id uuid    NOT NULL REFERENCES {{ kwim_team }}.document_revisions(id) ON DELETE CASCADE,
    figure_id   text    NOT NULL,
    page        integer,
    caption     text,
    object_key  text    NOT NULL,
    PRIMARY KEY (revision_id, figure_id)
);

-- Skills: task instructions agents search for and load. One row per skill;
-- every version's text is in skill_versions and nothing is overwritten.
CREATE TABLE IF NOT EXISTS {{ kwim_team }}.skills (
    id                 uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
    name               text        NOT NULL UNIQUE,
    status             text        NOT NULL DEFAULT 'current'
                                   CHECK (status IN ('current','retired')),
    current_version    integer     NOT NULL,
    owner              text,
    promoted_to        uuid,
    promoted_from_team text,
    promoted_from_id   uuid,
    created_at         timestamptz NOT NULL DEFAULT now(),
    created_by         text,
    updated_at         timestamptz NOT NULL DEFAULT now()
);

-- One row per version of a skill: the whole SKILL.md text, its parsed
-- frontmatter, and the embedding of the whole skill (null until the embedder
-- has run on it).
CREATE TABLE IF NOT EXISTS {{ kwim_team }}.skill_versions (
    skill_id     uuid        NOT NULL REFERENCES {{ kwim_team }}.skills(id) ON DELETE CASCADE,
    version      integer     NOT NULL,
    text         text        NOT NULL,
    description  text        NOT NULL,
    body         text        NOT NULL,
    agents       jsonb       NOT NULL DEFAULT '[]'::jsonb,
    tags         jsonb       NOT NULL DEFAULT '[]'::jsonb,
    refs         jsonb       NOT NULL DEFAULT '[]'::jsonb,
    embedding    real[],
    source       text        NOT NULL CHECK (source IN ('human','agent_proposal','promotion')),
    author       text,
    approver     text,
    proposal_id  uuid,
    created_at   timestamptz NOT NULL DEFAULT now(),
    PRIMARY KEY (skill_id, version)
);

CREATE INDEX IF NOT EXISTS idx_{{ kwim_team }}_skill_versions_fts
    ON {{ kwim_team }}.skill_versions
    USING gin (to_tsvector('english', description || ' ' || body));
